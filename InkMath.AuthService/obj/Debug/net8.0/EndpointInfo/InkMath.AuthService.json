{
  "openapi": "3.0.1",
  "info": {
    "title": "InkMath.AuthService",
    "version": "1.0"
  },
  "paths": {
    "/api/Auth/registro": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "Apellido",
                  "Email",
                  "Nombre",
                  "Password"
                ],
                "type": "object",
                "properties": {
                  "Nombre": {
                    "type": "string"
                  },
                  "Apellido": {
                    "type": "string"
                  },
                  "Email": {
                    "type": "string",
                    "format": "email"
                  },
                  "Password": {
                    "minLength": 8,
                    "type": "string"
                  },
                  "RoleId": {
                    "maximum": 3,
                    "minimum": 2,
                    "type": "integer",
                    "format": "int32"
                  },
                  "AceptoTerminos": {
                    "type": "boolean"
                  },
                  "Website": {
                    "type": "string"
                  }
                }
              },
              "encoding": {
                "Nombre": {
                  "style": "form"
                },
                "Apellido": {
                  "style": "form"
                },
                "Email": {
                  "style": "form"
                },
                "Password": {
                  "style": "form"
                },
                "RoleId": {
                  "style": "form"
                },
                "AceptoTerminos": {
                  "style": "form"
                },
                "Website": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Transacciones/crear": {
      "post": {
        "tags": [
          "Transacciones"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearTransaccionMonedaDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearTransaccionMonedaDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CrearTransaccionMonedaDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Transacciones/seed-data": {
      "post": {
        "tags": [
          "Transacciones"
        ],
        "parameters": [
          {
            "name": "cantidad",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50000
            }
          },
          {
            "name": "estudianteId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/WeatherForecast": {
      "get": {
        "tags": [
          "WeatherForecast"
        ],
        "operationId": "GetWeatherForecast",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CrearTransaccionMonedaDto": {
        "type": "object",
        "properties": {
          "tipoTransaccionId": {
            "type": "integer",
            "format": "int64"
          },
          "monto": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}